---
import type { HTMLAttributes } from 'astro/types'

export interface Props extends Omit<HTMLAttributes<'body'>, 'title'> {}
const props = Astro.props
---

<html lang='id' transition:animate='none'>
  <head>
    <meta charset='UTF-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1.0' />
    <slot name='head' />
  </head>
  <body {...props}>
    <slot />
  </body>
</html>
