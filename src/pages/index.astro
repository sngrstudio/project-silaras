---
import Layout from '~/layouts/layout.astro'
import { Debug } from 'astro:components'
import { db } from '~/db'
import { regionTable } from '~/db/schema/region'

if (!Astro.locals.user) {
  return Astro.redirect('/login')
}

const testdata = await db.select().from(regionTable)
---

<Layout>
  <Debug {testdata} />
</Layout>
