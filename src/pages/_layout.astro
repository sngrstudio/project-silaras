---
import BaseLayout, { type Props as BaseLayoutProps } from './_base.astro'
import Head, { type Props as HeadProps } from './_head.astro'
import { ClientRouter } from 'astro:transitions'
import Devtools from '~/components/common/devtools.astro'
import '~/styles/global.css'

export interface Props extends HeadProps, BaseLayoutProps {}
const { title, description, class: className, ...props } = Astro.props
---

<BaseLayout class:list={['h-screen overflow-hidden', className]} {...props}>
  {/* <body /> */}
  <slot />

  {/* <head /> */}
  <Fragment slot='head'>
    <Head title={title} description={description} />
    <ClientRouter />
    {import.meta.env.DEV && <Devtools />}
    <slot name='head' />
  </Fragment>
</BaseLayout>
