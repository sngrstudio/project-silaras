---
import MainLayout, {
  type Props as MainLayoutProps
} from '~/layouts/layout.astro'
import Navbar from './_navbar.astro'
import Drawer from '~/components/layout/drawer'

interface Props extends MainLayoutProps {}
const props = Astro.props
---

<MainLayout {...props}>
  <Navbar />
  <Drawer client:idle>
    <slot />
  </Drawer>
</MainLayout>
