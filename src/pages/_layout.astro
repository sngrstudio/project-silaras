---
import BaseLayout from './_base.astro'
import Meta, { type Props as MProps } from './_meta.astro'
import '~/styles/global.css'

export interface Props extends MProps {}

const { title, description } = Astro.props
---

<BaseLayout>
  {/* <body /> */}
  <slot />

  {/* <head /> */}
  <Fragment slot='head'>
    <Meta title={title} description={description} />
    <slot name='head' />
  </Fragment>
</BaseLayout>

<script>
  import '~/scripts/global'
</script>
