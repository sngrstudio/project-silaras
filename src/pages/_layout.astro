---
import MainLayout, {
  type Props as MainLayoutProps
} from '~/layouts/layout.astro'
import Navbar from './_navbar.astro'
import Drawer from '~/components/layout/drawer'

export interface Props extends MainLayoutProps {
  width?: 'normal' | 'full'
}

const { width = 'normal', ...props } = Astro.props
---

<MainLayout {...props}>
  <Navbar />
  <Drawer client:idle>
    <section
      class='mx-auto max-w-screen-md data-[width=full]:max-w-screen-xl'
      data-width={width}
    >
      {
        /* header */
        props.title && (
          <header class='border-base-300 mb-4 border-b pb-4'>
            <h1 class='text-4xl font-black'>{props.title}</h1>
            {props.description && <p class='mt-2'>{props.description}</p>}
          </header>
        )
      }
      {/* content */}
      <slot />
    </section>
  </Drawer>
</MainLayout>
