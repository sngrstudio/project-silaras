---
import MainLayout, {
  type Props as MainLayoutProps
} from '~/layouts/layout.astro'
import Navbar from './_navbar.astro'
import Drawer from '~/components/layout/drawer'

export interface Props extends MainLayoutProps {}
const props = Astro.props
---

<MainLayout {...props}>
  <Navbar />
  <Drawer client:idle>
    <section class='mx-auto max-w-screen-md'>
      {/* header */}
      {props.title && <h1 class='mb-6 text-4xl font-black'>{props.title}</h1>}
      {props.description && <p>{props.description}</p>}

      <slot />
    </section>
  </Drawer>
</MainLayout>
