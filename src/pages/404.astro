---
/**
 * @fileoverview 404 Not Found Error Page
 *
 * Custom 404 error page providing user-friendly messaging and navigation options
 * when requested resources cannot be found. Features helpful recovery actions
 * and maintains consistent design with the rest of the application.
 *
 * Features:
 * - User-friendly error messaging in Indonesian
 * - Navigation options back to home or search
 * - Consistent error layout styling
 * - Warning color theme for non-critical error
 * - Responsive design for all device sizes
 * - Accessibility-compliant error presentation
 *
 * Recovery Actions:
 * - Return to homepage button
 * - Search functionality access
 * - Clear navigation path for users
 * - Helpful error context and guidance
 *
 * User Experience:
 * - Non-threatening warning styling (not critical error)
 * - Clear explanation of what happened
 * - Multiple recovery options
 * - Consistent with site branding
 *
 * @author SNGR Creative
 * @version 1.0.0
 */

import ErrorLayout, { type Props as ErrorLayoutProps } from './_error.astro'
import HomeIcon from '~icons/lucide/home'
import SearchIcon from '~icons/lucide/search'

const props = {
  title: 'Halaman Tidak Ditemukan',
  description: 'Maaf, halaman yang Anda cari tidak dapat ditemukan.',
  errorCode: '404',
  errorTitle: 'Halaman Tidak Ditemukan',
  errorMessage:
    'Maaf, halaman yang Anda cari tidak dapat ditemukan. Mungkin halaman tersebut telah dipindahkan, dihapus, atau URL yang Anda masukkan salah.',
  errorColor: 'warning'
} satisfies ErrorLayoutProps
---

<ErrorLayout {...props}>
  {/* Action buttons */}
  <Fragment slot='actions'>
    <div class='flex flex-col justify-center gap-3 sm:flex-row'>
      {/* Home button */}
      <a
        href='/'
        class='group border-primary/30 from-primary/10 to-primary/5 text-primary hover:border-primary/50 hover:from-primary/20 hover:to-primary/10 hover:shadow-primary/20 inline-flex items-center justify-center gap-2 rounded-xl border bg-gradient-to-r px-6 py-3 text-sm font-medium transition-all duration-200 hover:scale-105 hover:shadow-lg'
      >
        <HomeIcon
          className='h-4 w-4 transition-transform duration-200 group-hover:scale-110'
        />
        <span>Kembali ke Beranda</span>
      </a>
    </div>
  </Fragment>

  {/* Additional help */}
  <Fragment slot='additional'>
    <div>
      <div
        class='card bg-base-200/30 border-base-300/30 border backdrop-blur-sm'
      >
        <div class='card-body p-6'>
          <div class='flex items-start gap-3'>
            <div
              class='bg-info/10 border-info/20 flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-lg border'
            >
              <SearchIcon className='text-info h-5 w-5' />
            </div>
            <div class='text-left'>
              <h3 class='text-base-content mb-2 font-semibold'>
                Bantuan Pencarian
              </h3>
              <p class='text-base-content/70 text-sm leading-relaxed'>
                Jika Anda mencari sesuatu yang spesifik, coba gunakan menu
                navigasi atau kembali ke halaman utama untuk memulai pencarian
                baru.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </Fragment>
</ErrorLayout>
