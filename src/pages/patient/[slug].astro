---
import DLayout, { type Props as DLayoutProps } from '../_dashboard.astro'
import Assesment from '~/components/assesments/assesment.astro'
import { actions } from 'astro:actions'
import BackIcon from '~icons/lucide/arrow-left'

const { user } = Astro.locals
if (!user) {
  return Astro.redirect('/user/login')
}

const { slug } = Astro.params
if (!slug) {
  return Astro.redirect('/')
}

const patient = await Astro.callAction(actions.patient.getBySlug.orThrow, {
  slug
})
if (!patient) {
  return Astro.redirect('/404')
}

const region = await Astro.callAction(actions.region.getById.orThrow, {
  id: patient.regionId
})

// Access control for patient pages
const hasAccess = await (async () => {
  // Admin (level 4) has access to everything
  if (user.accessLevel >= 4) {
    return true
  }

  // Viewers (level 1) are restricted for now
  if (user.accessLevel === 1) {
    return false
  }

  // If user has no region assignment, deny access
  if (!user.regionId) {
    return false
  }

  // Get user's assigned region
  const userRegion = await Astro.callAction(actions.region.getById.orThrow, {
    id: user.regionId
  })

  if (!userRegion) {
    return false
  }

  if (!region) {
    return false
  }

  // Coordinators (level 3) can access patients in desa under their kecamatan
  if (user.accessLevel === 3) {
    // Check if the patient's desa is under the user's kecamatan
    if (region.parentId === userRegion.id) {
      return true
    }

    return false
  }

  // Editors (level 2) can only access patients in their assigned desa
  if (user.accessLevel === 2) {
    // User can only access patients in their own desa
    if (region.id === userRegion.id && region.type === 'DESA') {
      return true
    }

    return false
  }

  return false
})()

// Redirect if user doesn't have access
if (!hasAccess) {
  return Astro.redirect('/')
}

const props = {
  title: patient.name,
  description: `Halaman pasien untuk ${patient.name}`
} satisfies DLayoutProps
---

<DLayout {...props}>
  <Assesment transition:name={patient.slug} transition:animate='none' />

  {
    /* controls */
    region && (
      <Fragment slot='controls'>
        <a class='btn btn-ghost md:btn-sm' href={`/region/${region.slug}`}>
          <BackIcon />
          <span>{region.name}</span>
        </a>
      </Fragment>
    )
  }
</DLayout>
