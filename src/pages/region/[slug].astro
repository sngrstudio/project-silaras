---
import DLayout, { type Props as DLayoutProps } from '../_dashboard.astro'
import Region from '~/components/region/region.astro'
import { actions } from 'astro:actions'

const { slug } = Astro.params
if (!slug) {
  return Astro.redirect('/')
}

const page = await Astro.callAction(actions.region.getBySlug.orThrow, { slug })
if (!page) {
  return Astro.redirect('/404')
}

const props = {
  title: page.name,
  description: `Selayang Pandang untuk ${page.type.toLowerCase()} ${page.name}`
} satisfies DLayoutProps
---

<DLayout {...props}>
  {
    page.type !== 'DESA' && (
      <Region transition:name={page.slug} transition:animate='none' />
    )
  }
</DLayout>
