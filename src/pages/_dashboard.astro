---
import Layout, { type Props as LProps } from './_layout.astro'
import ToastRC from '~/components/toast/toast'

interface Props extends LProps {}

const { ...props } = Astro.props
---

<Layout {...props}>
  {/* <body /> */}
  <ToastRC client:idle>
    <slot />
  </ToastRC>

  {/* <head /> */}
  <Fragment slot='head'>
    <slot name='head' />
  </Fragment>
</Layout>
