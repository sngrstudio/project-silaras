---
import Layout, { type Props as LayoutProps } from './_layout.astro'
import Navigation from '~/components/layout/navigation/navigation.astro'
import Drawer from '~/components/layout/drawer/drawer.astro'

export interface Props extends LayoutProps {}
const { class: className, ...props } = Astro.props
---

<Layout class:list={['', className]} {...props}>
  {/* <body /> */}
  <Navigation />
  <Drawer>
    {
      Astro.slots.has('controls') && (
        <div class='-mx-4 mb-4 flex w-full'>
          <slot name='controls' />
        </div>
      )
    }
    {
      /* <Header /> */
      props.title && (
        <header class='mb-8'>
          <h1 class='text-2xl font-black md:text-4xl'>{props.title}</h1>
          {props.description && (
            <p class='mt-1 text-sm md:mt-2 md:text-base'>{props.description}</p>
          )}
        </header>
      )
    }
    <slot />
  </Drawer>

  {/* <head /> */}
  <Fragment slot='head'>
    <slot name='head' />
  </Fragment>
</Layout>
