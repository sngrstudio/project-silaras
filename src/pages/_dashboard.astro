---
import Layout, { type Props as LProps } from './_layout.astro'
import ToastRC from '~/components/layout/toast/toast'
import NavbarRC from '~/components/layout/dashboard/navbar'
import DrawerRC from '~/components/layout/dashboard/drawer'

export interface Props extends LProps {}

const { ...props } = Astro.props
---

<Layout {...props}>
  {/* <body /> */}
  <ToastRC client:idle>
    <NavbarRC client:load transition:persist='navbar' />
    <DrawerRC client:load>
      {
        props.title && (
          <header class='mb-6'>
            <h1 class='text-2xl font-black lg:text-4xl'>{props.title}</h1>
            {props.description && <div class='mt-2'>{props.description}</div>}
          </header>
        )
      }
      <slot />
    </DrawerRC>
  </ToastRC>

  {/* <head /> */}
  <Fragment slot='head'>
    <slot name='head' />
  </Fragment>
</Layout>

<script>
  import { onMount, task } from 'nanostores'
  import {
    $menu,
    setMenu,
    $openDrawer,
    setOpenDrawer
  } from '~/components/layout/dashboard/store'
  import { actions } from 'astro:actions'

  onMount($menu, () => {
    task(async () => {
      const state = await actions.settings.menu.get.orThrow()
      setMenu(state)
    })

    return () => {
      setMenu(undefined)
    }
  })

  onMount($openDrawer, () => {
    return () => {
      setOpenDrawer(undefined)
    }
  })
</script>
