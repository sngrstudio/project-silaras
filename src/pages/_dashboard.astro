---
import Layout, { type Props as LProps } from './_layout.astro'
import ToastRC from '~/components/toast/toast'
import NavbarRC from '~/components/dashboard/navbar'
import DrawerRC from '~/components/dashboard/drawer'

export interface Props extends LProps {}

const { ...props } = Astro.props
---

<Layout {...props}>
  {/* <body /> */}
  <ToastRC client:idle>
    <NavbarRC client:load />
    <DrawerRC client:load>
      {
        props.title && (
          <header class='mb-6'>
            <h1 class='text-2xl font-black lg:text-4xl'>{props.title}</h1>
            {props.description && <div class='mt-2'>{props.description}</div>}
          </header>
        )
      }
      <slot />
    </DrawerRC>
  </ToastRC>

  {/* <head /> */}
  <Fragment slot='head'>
    <slot name='head' />
  </Fragment>
</Layout>
