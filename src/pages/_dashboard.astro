---
import Layout, { type Props as LayoutProps } from './_layout.astro'

export interface Props extends LayoutProps {}
const { ...props } = Astro.props
---

<Layout {...props}>
  {/* <body /> */}
  <slot />

  {/* <head /> */}
  <Fragment slot='head'>
    <slot name='head' />
  </Fragment>
</Layout>
