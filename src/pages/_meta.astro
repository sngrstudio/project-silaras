---
import { actions } from 'astro:actions'

export interface Props {
  title?: string | undefined
  description?: string | undefined
}

const { title, description } = Astro.props

const settings = await Astro.callAction(actions.settings.get.orThrow, {})

const site = {
  title: settings.find((s) => s.property === 'SITE_NAME')?.value,
  description: settings.find((s) => s.property === 'SITE_DESCRIPTION')?.value
} satisfies Props
---

<title>{title ? `${title} | ${site.title}` : site.title}</title>
<meta name='description' content={description || site.description} />
<link rel='canonical' href={Astro.url} />

{/* prevent robots */}
<meta name='robots' content='noindex' />
