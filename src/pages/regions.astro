---
import DashboardLayout, { type Props as LProps } from './_dashboard.astro'
import RegionsRC from '~/components/pages/regions/regions'

if (!Astro.locals.session || !Astro.locals.user) {
  return Astro.redirect('/user/login')
}

const props = {
  title: 'Kecamatan',
  description: 'Daftar & pengaturan Kecamatan'
} satisfies LProps
---

<DashboardLayout {...props}>
  <RegionsRC client:idle transition-name='regions' />
</DashboardLayout>

<script>
  import { onMount, task } from 'nanostores'
  import { $regions, setRegions } from '~/components/pages/regions/store'
  import { actions } from 'astro:actions'

  onMount($regions, () => {
    task(async () => {
      const state = await actions.region.get.orThrow({ type: 'SUBDISTRICT' })
      setRegions(state)
    })

    return () => {
      setRegions(undefined)
    }
  })
</script>
