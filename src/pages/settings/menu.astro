---
import MenuComponent from '~/components/settings/menu/menu.astro'
import DLayout, { type Props as DLayoutProps } from '../_dashboard.astro'
import BackIcon from '~icons/lucide/arrow-left'

const { user } = Astro.locals
if (!user) {
  return Astro.redirect('/user/login')
}

// Check if user has admin access (accessLevel >= 4)
if (user.accessLevel < 4) {
  return Astro.redirect('/')
}

const props = {
  title: 'Menu',
  description: `Setelan menu harian.`
} satisfies DLayoutProps
---

<DLayout {...props}>
  <MenuComponent transition:name='settings-menu' transition:animate='none' />

  <Fragment slot='controls'>
    <a class='btn btn-ghost md:btn-sm' href='/'>
      <BackIcon />
      Beranda
    </a>
  </Fragment>
</DLayout>
