---
import DashboardLayout, { type Props as LProps } from '../_dashboard.astro'
import SettingsSiteRC from '~/components/pages/settings/site'

if (!Astro.locals.session || !Astro.locals.user) {
  return Astro.redirect('/user/login')
}

if (Astro.locals.user.accessLevel < 4) {
  return Astro.redirect('/')
}

const props = {
  title: 'Pengaturan Situs',
  description: 'Edit dan ubah pengaturan situs.'
} satisfies LProps
---

<DashboardLayout {...props}>
  <SettingsSiteRC client:idle transition-name='settings' />
</DashboardLayout>

<script>
  import { onMount, task } from 'nanostores'
  import {
    $user,
    setUser,
    $accessLevels,
    setAccessLevels
  } from '~/components/pages/profile/store'
  import { actions } from 'astro:actions'

  onMount($user, () => {
    task(async () => {
      const state = await actions.user.getCurrent.orThrow()
      setUser(state)
    })

    return () => {
      setUser(undefined)
    }
  })

  onMount($accessLevels, () => {
    task(async () => {
      const state = await actions.user.accessLevels.get.orThrow()
      setAccessLevels(state)
    })

    return () => {
      setAccessLevels(undefined)
    }
  })
</script>
