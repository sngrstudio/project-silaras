---
/**
 * @fileoverview User Management Administrative Page
 *
 * Comprehensive user management interface for system administrators and coordinators
 * to manage user accounts, access levels, and permissions within the SILARAS system.
 * Provides full CRUD operations for user administration with proper access controls.
 *
 * Features:
 * - Complete user account management
 * - Access level and permission configuration
 * - User role assignment and modification
 * - Account activation and deactivation
 * - Regional assignment management
 * - Coordinator-level access control (level 3+)
 *
 * User Management Operations:
 * - Create new user accounts
 * - Modify existing user information
 * - Change access levels and permissions
 * - Assign users to regional jurisdictions
 * - Deactivate or suspend accounts
 * - Reset user passwords and credentials
 *
 * Access Control Hierarchy:
 * - Level 1: Basic User (Enumerator)
 * - Level 2: Regional Officer
 * - Level 3: Coordinator (minimum for user management)
 * - Level 4: Administrator (full system access)
 *
 * Security Features:
 * - Minimum access level 3 required
 * - Proper authorization validation
 * - Audit trail for user modifications
 * - Protected administrative functions
 * - Regional jurisdiction respect
 *
 * Dashboard Integration:
 * - Full dashboard layout support
 * - Responsive design for all devices
 * - Navigation breadcrumbs
 * - Consistent UI patterns
 *
 * @author SNGR Creative
 * @version 1.0.0
 */

import DLayout, { type Props as DLayoutProps } from '../_dashboard.astro'
import UsersComponent from '~/components/settings/users/users.astro'

const { user } = Astro.locals
if (!user) {
  return Astro.redirect('/user/login')
}

// Check if user has coordinator access or above (accessLevel >= 3)
if (user.accessLevel < 3) {
  return Astro.redirect('/')
}

const props = {
  title: 'Manajemen Pengguna',
  description: 'Kelola pengguna sistem dan hak akses mereka'
} satisfies DLayoutProps
---

<DLayout {...props}>
  <UsersComponent />
</DLayout>
