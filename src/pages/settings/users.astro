---
import DLayout, { type Props as DLayoutProps } from '../_dashboard.astro'
import UsersComponent from '~/components/settings/users/users.astro'

const { user } = Astro.locals
if (!user) {
  return Astro.redirect('/user/login')
}

// Check if user has admin access (accessLevel >= 4)
if (user.accessLevel < 4) {
  return Astro.redirect('/')
}

const props = {
  title: 'Manajemen Pengguna',
  description: 'Kelola pengguna sistem dan hak akses mereka'
} satisfies DLayoutProps
---

<DLayout {...props}>
  <UsersComponent />
</DLayout>
