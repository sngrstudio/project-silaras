---
import DashboardLayout, { type Props as LProps } from '../_dashboard.astro'
import UsersRC from '~/components/pages/users/users'

if (!Astro.locals.session || !Astro.locals.user) {
  return Astro.redirect('/user/login')
}

if (Astro.locals.user.accessLevel < 3) {
  return Astro.redirect('/')
}

const props = {
  title: 'Pengaturan Pengguna',
  description: 'Edit dan ubah pengaturan pengguna.'
} satisfies LProps
---

<DashboardLayout {...props}>
  <UsersRC client:idle transition-name='users' />
</DashboardLayout>

<script>
  import { onMount, task } from 'nanostores'
  import { $allUser, setAllUser } from '~/components/pages/users/store'
  import {
    $accessLevels,
    setAccessLevels
  } from '~/components/pages/profile/store'
  import { actions } from 'astro:actions'

  onMount($allUser, () => {
    task(async () => {
      const state = await actions.user.getAll.orThrow()
      setAllUser(state)
    })

    return () => {
      setAllUser(undefined)
    }
  })

  onMount($accessLevels, () => {
    task(async () => {
      const state = await actions.user.accessLevels.get.orThrow()
      setAccessLevels(state)
    })

    return () => {
      setAccessLevels(undefined)
    }
  })
</script>
