---
import DashboardLayout, { type Props as LProps } from '../_dashboard.astro'
import ProfileRC from '~/components/pages/profile/profile'

if (!Astro.locals.session || !Astro.locals.user) {
  return Astro.redirect('/user/login')
}

const props = {
  title: 'Profil Saya',
  description: 'Edit dan ubah profil pengguna.'
} satisfies LProps
---

<DashboardLayout {...props}>
  <ProfileRC client:idle />
</DashboardLayout>

<script>
  import { onMount, task } from 'nanostores'
  import {
    $user,
    setUser,
    $accessLevels,
    setAccessLevels
  } from '~/components/pages/profile/store'
  import { actions } from 'astro:actions'

  onMount($user, () => {
    task(async () => {
      const state = await actions.user.getCurrentUser.orThrow()
      setUser(state)
    })

    return () => {
      setUser(undefined)
    }
  })

  onMount($accessLevels, () => {
    task(async () => {
      const state = await actions.user.accessLevels.get.orThrow()
      setAccessLevels(state)
    })

    return () => {
      setAccessLevels(undefined)
    }
  })
</script>
