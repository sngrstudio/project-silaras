---
import Layout, { type Props } from '../_layout.astro'
import ProfileCardRC from '~/components/pages/profile'

if (!Astro.locals.user || !Astro.locals.session) {
  return Astro.redirect('/user/login')
}

const props = {
  title: 'Halaman Profil',
  description: 'Edit profil Anda di halaman ini.'
} satisfies Props
---

<Layout {...props}>
  <!-- <ProfileCardRC title='Profil Anda' client:idle /> -->
</Layout>
