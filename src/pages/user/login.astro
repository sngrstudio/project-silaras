---
import Layout from './_layout.astro'
import LoginRC from '~/components/user/login'
import { actions } from 'astro:actions'

if (Astro.locals.user || Astro.locals.session) {
  return Astro.redirect('/')
}

const userIsEmpty = await Astro.callAction(actions.auth.isUserEmpty.orThrow, {})
if (userIsEmpty) {
  console.log(userIsEmpty)
  return Astro.redirect('/user/signup')
}

const title = 'Login'
---

<Layout title={title}>
  <LoginRC title={title} client:load />
</Layout>
