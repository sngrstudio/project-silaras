---
import UserLayout, { type Props as LProps } from './_user.astro'
import LoginRC from '~/components/user/login'
import { actions } from 'astro:actions'

if (Astro.locals.session && Astro.locals.user) {
  return Astro.redirect('/')
}

if (await Astro.callAction(actions.user.checks.isUserEmpty.orThrow, {})) {
  return Astro.redirect('/user/signup?first=true')
}

const props = {
  title: 'Login',
  description: 'Halaman login.'
} satisfies LProps

const username = Astro.url.searchParams.get('user') ?? undefined
---

<UserLayout {...props}>
  <LoginRC username={username} client:load />
</UserLayout>
