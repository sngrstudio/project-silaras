---
import { actions } from 'astro:actions'
import ErrorBox from './_error-box.astro'

if (Astro.locals.session) {
  return Astro.redirect('/')
}

const actionResult = Astro.getActionResult(actions.auth.login)
if (actionResult && !actionResult.error) {
  return Astro.redirect('/')
}
---

<h1>Login</h1>

<form action={actions.auth.login} method='post'>
  <label for='userName'>Username</label>
  <input type='text' name='userName' id='userName' required />

  <label for='password'>Password</label>
  <input type='password' name='password' id='password' required />

  <input type='submit' value='Login' />
</form>

<ErrorBox result={actionResult} />

<a href='/user/signup' role='button'>Buat akun</a>
