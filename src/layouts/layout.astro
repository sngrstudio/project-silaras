---
import BaseLayout, { type Props as BaseLayoutProps } from './base.astro'
import Meta, { type Props as MetaProps } from './meta.astro'
import ToastWrapper from '~/components/toast/toast'
import './global.css'

export interface Props extends BaseLayoutProps, MetaProps {}

const { title, description, canonical, lang, ...props } = Astro.props
---

<BaseLayout lang='id' {...props}>
  {/* <body> */}
  <ToastWrapper client:load>
    <slot />
  </ToastWrapper>

  {/* <head> */}
  <Fragment slot='head'>
    <Meta title={title} description={description} canonical={canonical} />
    <slot name='head' />
  </Fragment>
</BaseLayout>
