---
import { actions } from 'astro:actions'
export interface Props {
  title?: string | undefined
  description?: string | undefined
  canonical?: string | undefined
}

const { title, description, canonical } = Astro.props

const settings = await Astro.callAction(actions.settings.get.orThrow, {})
const site = {
  title: settings.find((s) => s.property === 'SITE_NAME')?.value || '',
  description:
    settings.find((s) => s.property === 'SITE_DESCRIPTION')?.value || ''
} satisfies Props
---

{/* Basic metadata */}
<title>{title ? `${title} \u2014 ${site.title}` : site.title}</title>
<meta
  name='description'
  content={description ? description : site.description}
/>
<link rel='canonical' href={canonical ? canonical : Astro.url} />

{/* Favicon */}
<link rel='icon' type='image/svg+xml' href='/favicon.svg' />
