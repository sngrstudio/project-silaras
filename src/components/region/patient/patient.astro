---
import PatientRC from './patient'
import CardTemplateRC from '../../common/card/card'
import PatientDialogRC from './patient-dialog'
---

<CardTemplateRC>
  <PatientRC client:idle />
  <PatientDialogRC client:only='react' />
</CardTemplateRC>

<script>
  import { onMount, task } from 'nanostores'
  import { $patients, setPatients } from './patient.store'
  import { actions } from 'astro:actions'

  const getRegionSlug = () => window.location.pathname.split('/').at(-1) ?? ''

  onMount($patients, () => {
    task(async () => {
      const state = await actions.patient.getAll.orThrow({
        regionSlug: getRegionSlug()
      })
      setPatients(state)
    })
    return () => {
      setPatients(undefined)
    }
  })

  document.addEventListener('astro:page-load', async () => {
    const state = await actions.patient.getAll.orThrow({
      regionSlug: getRegionSlug()
    })
    setPatients(state)
  })
</script>
