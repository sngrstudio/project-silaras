---
import PatientRC from './patient'
import CardTemplateRC from '../../common/card/card'
import PatientDialogRC from './patient-dialog'
---

<CardTemplateRC>
  <PatientRC client:idle />
  <PatientDialogRC client:only='react' />
</CardTemplateRC>

<script>
  import { onMount, task } from 'nanostores'
  import {
    $patients,
    setPatients,
    $currentRegion,
    setCurrentRegion
  } from './patient.store'
  import { actions } from 'astro:actions'

  const getRegionSlug = () => window.location.pathname.split('/').at(-1) ?? ''

  onMount($currentRegion, () => {
    task(async () => {
      const state = await actions.region.getBySlug.orThrow({
        slug: getRegionSlug()
      })
      setCurrentRegion(state!)
    })
    return () => {
      setCurrentRegion(undefined)
    }
  })

  onMount($patients, () => {
    task(async () => {
      const state = await actions.patient.getAll.orThrow({
        regionSlug: getRegionSlug()
      })
      setPatients(state)
    })
    return () => {
      setPatients(undefined)
    }
  })

  document.addEventListener('astro:page-load', async () => {
    const currentRegionState = await actions.region.getBySlug.orThrow({
      slug: getRegionSlug()
    })
    setCurrentRegion(currentRegionState!)

    const patientsState = await actions.patient.getAll.orThrow({
      regionSlug: getRegionSlug()
    })
    setPatients(patientsState)
  })
</script>
