---
import RegionRC from './region'
import CardTemplateRC from '../common/card/card'
---

<CardTemplateRC>
  <RegionRC client:idle />
</CardTemplateRC>

<script>
  import { onMount, task } from 'nanostores'
  import { $regions, setRegions } from './region.store'
  import { actions } from 'astro:actions'

  onMount($regions, () => {
    task(async () => {
      const state = await actions.region.getAll.orThrow({
        parentId: '0196f800-ff2c-7000-a88b-570020a1feb8' // temporary
      })
      setRegions(state)
    })
    return () => {
      setRegions(undefined)
    }
  })
</script>
