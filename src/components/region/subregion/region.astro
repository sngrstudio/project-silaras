---
import RegionRC from './region'
import CardTemplateRC from '~/components/common/card/card'
---

<CardTemplateRC>
  <RegionRC client:idle />
</CardTemplateRC>

<script>
  import { onMount, task } from 'nanostores'
  import { $regions, setRegions } from './region.store'
  import { actions } from 'astro:actions'

  const parentSlug = window.location.pathname.split('/').at(-1) ?? ''

  onMount($regions, () => {
    task(async () => {
      const state = await actions.region.getAll.orThrow({
        parentSlug
      })
      setRegions(state)
    })
    return () => {
      setRegions(undefined)
    }
  })

  document.addEventListener('astro:page-load', async () => {
    const newParentSlug = window.location.pathname.split('/').at(-1) ?? ''
    const state = await actions.region.getAll.orThrow({
      parentSlug: newParentSlug
    })
    setRegions(state)
  })
</script>
