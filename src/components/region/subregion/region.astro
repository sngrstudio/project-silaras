---
import RegionRC from './region'
import CardTemplateRC from '~/components/common/card/card'
import type { Regions } from './region.store'

interface Props {
  regionsData?: Regions
}

const { regionsData } = Astro.props
---

<CardTemplateRC>
  <RegionRC client:idle regionsData={regionsData} />
</CardTemplateRC>

<script>
  import { setRegions } from './region.store'
  import { actions } from 'astro:actions'

  // Handle view transitions - reload data when navigating between regions
  document.addEventListener('astro:page-load', async () => {
    const newParentSlug = window.location.pathname.split('/').at(-1) ?? ''
    try {
      const state = await actions.region.getAllWithCounts.orThrow({
        parentSlug: newParentSlug
      })
      setRegions(state)
    } catch (error) {
      console.error('Failed to load regions data on page transition:', error)
      setRegions(undefined)
    }
  })
</script>
