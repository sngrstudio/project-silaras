---
import SiteSettingsRC from './site'
---

<section>
  <SiteSettingsRC client:load />
</section>

<script>
  import { onMount, task } from 'nanostores'
  import { $siteSettings, setSiteSettings } from './site.store'
  import { actions } from 'astro:actions'

  onMount($siteSettings, () => {
    task(async () => {
      const state = await actions.site.getAll.orThrow()
      setSiteSettings(state)
    })

    return () => {
      setSiteSettings(undefined)
    }
  })
</script>
