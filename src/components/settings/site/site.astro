---
/**
 * @fileoverview Site Settings Layout Component
 *
 * This Astro component provides the layout structure for site settings management
 * within the SILARAS platform. It integrates the site configuration interface with
 * client-side data synchronization and state management for system-wide settings.
 *
 * Key Features:
 * - Site settings management interface
 * - Client-side data synchronization using nanostores
 * - Real-time settings updates and store management
 * - Integration with site configuration system
 *
 * Component Integration:
 * - SiteSettingsRC: Main site configuration interface
 *
 * Data Management:
 * - Client-side store initialization for site settings
 * - Real-time synchronization with server-side configuration
 * - Integration with site management actions
 *
 * Store Management:
 * - Site settings data synchronization
 * - Real-time updates with server-side settings
 * - Integration with system configuration for site-wide changes
 *
 * @module Components/Settings/Site
 * @author SNGR Creative
 * @since 1.0.0
 */

import SiteSettingsRC from './site'
---

<section>
  <SiteSettingsRC client:load />
</section>

<script>
  import { onMount, task } from 'nanostores'
  import { $siteSettings, setSiteSettings } from './site.store'
  import { actions } from 'astro:actions'

  onMount($siteSettings, () => {
    task(async () => {
      const state = await actions.site.getAll.orThrow()
      setSiteSettings(state)
    })

    return () => {
      setSiteSettings(undefined)
    }
  })
</script>
