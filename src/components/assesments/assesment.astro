---
import AssesmentRC from './assesment'
import CardTemplateRC from '~/components/common/card/card'
---

<CardTemplateRC>
  <AssesmentRC client:idle />
</CardTemplateRC>

<script>
  import { onMount, task } from 'nanostores'
  import {
    $dailyAssesments,
    setDailyAssesments,
    $currentMonthIndex,
    setCurrentMonthIndex
  } from './assesment.store'
  import { actions } from 'astro:actions'

  const getPatientSlug = () => window.location.pathname.split('/').at(-1) || ''

  onMount($currentMonthIndex, () => {
    const state = Math.min(10, Math.max(6, new Date().getMonth() + 1))
    setCurrentMonthIndex(state)

    return () => {
      setCurrentMonthIndex(0)
    }
  })

  onMount($dailyAssesments, () => {
    task(async () => {
      const state = await actions.assesment.daily.getAll.orThrow({
        patientSlug: getPatientSlug(),
        monthIndex: $currentMonthIndex.get()
      })
      setDailyAssesments(state)
    })

    return () => {
      setDailyAssesments([])
    }
  })

  $currentMonthIndex.subscribe(async (monthIndex) => {
    const nextState = await actions.assesment.daily.getAll.orThrow({
      patientSlug: getPatientSlug(),
      monthIndex
    })
    setDailyAssesments(nextState)
  })

  // Refetch on page navigation
  document.addEventListener('astro:page-load', async () => {
    const newState = await actions.assesment.daily.getAll.orThrow({
      patientSlug: getPatientSlug(),
      monthIndex: $currentMonthIndex.get()
    })
    setDailyAssesments(newState)
  })
</script>
