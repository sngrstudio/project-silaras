{
  "name": "dashat-by-bkkbn",
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "astro": "astro",
    "build": "conc bun:check:* && astro build",
    "check:astro": "astro check",
    "check:style": "prettier --check .",
    "db:generate": "drizzle-kit generate --config=drizzle.config.mjs",
    "db:migrate": "drizzle-kit migrate --config=drizzle.config.mjs",
    "db:push": "drizzle-kit push --config=drizzle.config.mjs",
    "db:seed": "bun ./src/db/seed/seed.ts",
    "db:studio": "drizzle-kit studio --config=drizzle.config.mjs --host=0.0.0.0 --port=3308",
    "dev": "astro dev --host=0.0.0.0",
    "format": "prettier --write .",
    "preview": "astro preview"
  },
  "dependencies": {
    "@astrojs/node": "^9.2.1",
    "@astrojs/react": "^4.2.5",
    "@oslojs/crypto": "^1.0.1",
    "@oslojs/encoding": "^1.1.0",
    "astro": "5.7.4",
    "drizzle-orm": "^0.42.0",
    "drizzle-zod": "^0.7.1",
    "express": "^5.1.0",
    "morgan": "^1.10.0",
    "mysql2": "^3.14.0",
    "nanoid": "^5.1.5",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.4",
    "@types/bun": "^1.2.11",
    "@types/express": "^5.0.1",
    "@types/morgan": "^1.9.9",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "concurrently": "9.1.2",
    "drizzle-kit": "^0.31.0",
    "prettier": "3.5.3",
    "prettier-config-standard": "7.0.0",
    "prettier-plugin-astro": "0.14.1",
    "tsx": "^4.19.3",
    "typescript": "5.8.3"
  }
}
