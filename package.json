{
  "name": "project-dashat",
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "astro": "astro",
    "build": "conc bun:check:* && astro build",
    "check:astro": "astro check",
    "check:style": "prettier --check .",
    "db:generate": "drizzle-kit generate --config=drizzle.config.mjs",
    "db:migrate": "drizzle-kit migrate --config=drizzle.config.mjs",
    "db:push": "drizzle-kit push --config=drizzle.config.mjs",
    "db:seed": "bun ./src/db/seed/seed.ts",
    "db:studio": "drizzle-kit studio --host=0.0.0.0 --config=drizzle.config.mjs",
    "dev": "conc bun:dev:*",
    "dev:astro": "astro dev",
    "format": "prettier --write .",
    "preview": "astro preview"
  },
  "dependencies": {
    "@astrojs/node": "^9.2.1",
    "@astrojs/react": "^4.2.7",
    "@nanostores/persistent": "^1.0.0",
    "@nanostores/react": "^1.0.0",
    "@oslojs/crypto": "^1.0.1",
    "@oslojs/encoding": "^1.1.0",
    "@tailwindcss/vite": "^4.1.5",
    "@tanstack/react-table": "^8.21.3",
    "astro": "5.7.7",
    "drizzle-orm": "^0.43.1",
    "drizzle-zod": "^0.7.1",
    "express": "^5.1.0",
    "morgan": "^1.10.0",
    "mysql2": "^3.14.1",
    "nanostores": "^1.0.1",
    "radix-ui": "^1.3.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwindcss": "^4.1.5"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.4",
    "@iconify/json": "^2.2.334",
    "@svgr/core": "^8.1.0",
    "@svgr/plugin-jsx": "^8.1.0",
    "@types/bun": "^1.2.11",
    "@types/express": "^5.0.1",
    "@types/morgan": "^1.9.9",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.3",
    "concurrently": "9.1.2",
    "daisyui": "^5.0.35",
    "drizzle-kit": "^0.31.1",
    "prettier": "3.5.3",
    "prettier-config-standard": "7.0.0",
    "prettier-plugin-astro": "0.14.1",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "typescript": "5.8.3",
    "unplugin-icons": "^22.1.0"
  }
}
