    "@cloudinary/url-gen": "1.21.0",
    "@fontsource-variable/plus-jakarta-sans": "5.2.6",
    "@nanostores/persistent": "1.0.0",
    "@nanostores/react": "1.0.0",
    "@oslojs/crypto": "1.0.1",
    "@oslojs/encoding": "1.1.0",
    "@tailwindcss/vite": "4.1.6",
    "@tanstack/react-table": "8.21.3",
    "argon2": "0.43.0",
    "astro": "5.9.0",
    "cloudinary": "2.6.1",
    "clsx": "2.1.1",
    "drizzle-orm": "0.43.1",
    "drizzle-zod": "0.7.1",
    "express": "5.1.0",
    "leaflet": "1.9.4",
    "morgan": "1.10.0",
    "mysql2": "3.14.1",
    "nanostores": "1.0.1",
    "radix-ui": "1.4.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-leaflet": "5.0.0",
    "tailwindcss": "4.1.6"
