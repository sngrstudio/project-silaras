{
  "name": "dashat-by-bkkbn",
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "astro": "astro",
    "build": "conc npm:check:* && astro build",
    "check:astro": "astro check",
    "check:style": "prettier --check .",
    "dev": "astro dev --host=0.0.0.0",
    "format": "prettier --write .",
    "preview": "astro preview",
    "db:push": "drizzle-kit push --config=drizzle.config.mjs",
    "db:studio": "drizzle-kit studio --config=drizzle.config.mjs --host=0.0.0.0 --port=3308"
  },
  "dependencies": {
    "@astrojs/node": "^9.2.1",
    "astro": "5.7.4",
    "drizzle-orm": "^0.42.0",
    "mysql2": "^3.14.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.4",
    "@types/node": "^22.15.1",
    "concurrently": "9.1.2",
    "drizzle-kit": "^0.31.0",
    "prettier": "3.5.3",
    "prettier-config-standard": "7.0.0",
    "prettier-plugin-astro": "0.14.1",
    "typescript": "5.8.3"
  }
}
