{
  "name": "project-silaras",
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "astro": "astro",
    "build": "conc npm:check:* && astro build",
    "check:astro": "astro check",
    "check:style": "prettier --check .",
    "db:generate": "drizzle-kit generate --config=drizzle.config.mjs",
    "db:migrate": "drizzle-kit migrate --config=drizzle.config.mjs",
    "db:push": "drizzle-kit push --config=drizzle.config.mjs",
    "db:seed": "tsx ./src/db/seed/seed.ts",
    "db:studio": "drizzle-kit studio --host=0.0.0.0 --config=drizzle.config.mjs",
    "dev": "conc npm:dev:*",
    "dev:astro": "astro dev",
    "format": "prettier --write .",
    "preview": "astro preview"
  },
  "dependencies": {
    "@astrojs/node": "9.2.2",
    "@astrojs/react": "4.3.0",
    "@aws-sdk/client-s3": "3.821.0",
